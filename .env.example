# Salin menjadi .env lalu sesuaikan
PORT=3000
# Alamat yang didengarkan. 127.0.0.1 = hanya dari server ini (disarankan untuk produksi di belakang Apache).
HOST=127.0.0.1

# MariaDB / MySQL (XAMPP default: user root, tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=webrw3
# Opsional: UNIX socket XAMPP (macOS)
# DB_SOCKET=/Applications/XAMPP/xamppfiles/var/mysql/mysql.sock

# Admin pertama (hanya dipakai saat `npm run init-db`). Jika ADMIN_PASSWORD kosong,
# password acak dibuat dan ditampilkan sekali di terminal.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Opsional: rahasia penanda token. Jika kosong dibuat otomatis di file .token_secret
TOKEN_SECRET=

# Isi 1 jika server berada di belakang proxy/Nginx (agar IP asli terbaca)
TRUST_PROXY=0
